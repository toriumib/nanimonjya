{
  "id": "act5_sc02",
  "chapter": "ACT V ／ 呼名",
  "bg": "ship_hall",
  "bgAge": 10,
  "bgm": { "id": "roll_call", "fade": 2.0 },
  "lines": [
    { "t": "mono", "text": "降下の前に、点呼をする。" },
    { "t": "mono", "text": "五百人ぶんの名簿を、記録官が読み上げる。" },
    { "t": "mono", "text": "それが決まりだった。誰が決めたのかは、もう誰も覚えていない。" },

    { "t": "mono", "text": "私は台帳を開いた。三冊目。" },
    { "t": "mono", "text": "まだどちらでもない者の帳面。" },
    { "t": "mono", "text": "百四十五年前に空けたまま、埋めていない欄がある。" },

    { "t": "say", "name": "土倉", "sprite": "tsuchikura/normal",
      "text": "……無理をしなくていい。私の欄は、空のままでいい。" },
    { "t": "say", "name": "土倉", "sprite": "tsuchikura/normal",
      "text": "六十八だった男が、三百二十七年ぶんの冷凍を越えた。" },
    { "t": "say", "name": "土倉", "sprite": "tsuchikura/smile",
      "text": "それだけで、十分に出来すぎだよ。" },

    { "t": "mono", "text": "顔は、目の前にある。" },
    { "t": "mono", "text": "声も聞こえている。" },
    { "t": "mono", "text": "名前だけが、まだ、出てこない。" },

    { "t": "mono", "text": "——名刺は、一枚も無かった。" },
    { "t": "mono", "text": "データベースは、いまも鍵がかかっている。" },
    { "t": "mono", "text": "手がかりは、聞き込みで集めた断片だけだ。" },
    { "t": "mono", "text": "横浜、戸塚生まれ。ゴルフ。備蓄庫の最後の紙。" },
    { "t": "mono", "text": "そして——十六人が、彼のことをこう呼んでいた。" },

    { "t": "input", "expect": "とくらげんぞう", "onSuccess": "act5_sc03" },

    { "t": "mono", "text": "……いや。ちがう。" },
    { "t": "mono", "text": "もう一度、はじめから思い出す。" },
    { "t": "jump", "to": "act5_sc02" }
  ]
}
