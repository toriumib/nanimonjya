{
  "id": "ending_bitter",
  "chapter": "ENDING ／ 同窓会エンド",
  "bg": "lhs1140_city",
  "bgAge": 0,
  "bgm": { "id": "ending_reunion", "fade": 3.0 },
  "lines": [
    { "t": "mono", "text": "誰のことも、同じくらい大切だった。" },
    { "t": "mono", "text": "だから誰とも、特別にはならなかった。" },

    { "t": "mono", "text": "五百人で降り、五百人で街を作った。" },
    { "t": "mono", "text": "私はそのまま記録官を続けている。" },
    { "t": "mono", "text": "生まれた者の帳面が、いちばん厚くなった。" },

    { "t": "mono", "text": "特別な相手はいない。" },
    { "t": "mono", "text": "けれど、名前を呼べば必ず誰かが振り向く街にはなった。" },
    { "t": "mono", "text": "それは、悪くない暮らしだと思う。" },

    { "t": "fx", "kind": "flash" },
    { "t": "mono", "text": "——数世代あと。" },
    { "t": "mono", "text": "子孫たちが、少し恨めしそうに言う。" },

    { "t": "say", "name": "子孫", "sprite": "",
      "text": "ねえご先祖さま。うちの家系図、みんな顔が似すぎてて見分けつかないんだけど。" },
    { "t": "say", "name": "記録官", "sprite": "",
      "text": "……それは、ごめん。" },
    { "t": "say", "name": "子孫", "sprite": "",
      "text": "でも名前は、全員ぶん残ってた。ぜんぶ、あなたの字で。" },

    { "t": "mono", "text": "台帳は、三百年ぶん残っている。" },
    { "t": "mono", "text": "顔は似ていても、名前は一人ずつ違う。" },
    { "t": "mono", "text": "見分けがつかないなら、呼べばいい。" },

    { "t": "mono", "text": "＊" },
    { "t": "mono", "text": "PROJECT NOA ／ 同窓会エンド" },
    { "t": "mono", "text": "五百人が、家族になった。" }
  ]
}
